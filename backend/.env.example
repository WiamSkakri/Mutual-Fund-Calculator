# Database Configuration
# PostgreSQL connection URL
DATABASE_URL=jdbc:postgresql://localhost:5432/mutualfunds

# Database credentials
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=your_secure_password_here

# Server Configuration
# Port the Spring Boot application will run on
PORT=8095

# Newton Analytics API (if applicable)
# Add any API keys or external service credentials here
# NEWTON_API_KEY=your_api_key_here
